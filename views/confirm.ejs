<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation</title>
</head>
<body>
    <%- include('partials/header') %>
    <h1>Confirmed</h1>

    <h2> Form Details</h2>
    <p> Name: <%= form.fname %> <%= form.lname %> </p>
    <p> Job Title: <%= form.jobtitle %></p>
    <p> Company: <%= form.company %></p>
    <p> LinkedIn URL:<%= form.linkedin %></p>
    <p> Email:<%= form.email %></p>
    <p> Meeting:<%= form.meeting %></p>
    <p> Other:<%= form.other %></p>
    <p> Message:<%= form.message %></p>
    <p> Mailing:<%= form.mail %></p>
    <p> Email Format:<%= form.format %></p>
    <p> Times:<%= form.timestamp %></p>

    <div>
        <a href="/">Back to Contact Form</a>
        <br>
        <%- include('partials/footer') %>
    </div>
</body>
</html>